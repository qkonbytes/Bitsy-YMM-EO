{% schema %}
{
  "name": "YMM Search",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Parts For Your Vehicle"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e63e2f"
    }
  ]
}
{% endschema %}

<div class="bitsy-ymm-search" id="bitsy-ymm-search">
  <div class="bitsy-ymm-inner">
    <span class="bitsy-ymm-heading">{{ block.settings.heading }}</span>
    <div class="bitsy-ymm-dropdowns">
      <select id="bitsy-make" class="bitsy-ymm-select">
        <option value="">Select Make</option>
      </select>
      <select id="bitsy-model" class="bitsy-ymm-select" disabled>
        <option value="">Select Model</option>
      </select>
      <select id="bitsy-year" class="bitsy-ymm-select" disabled>
        <option value="">Select Year</option>
      </select>
      <button
        id="bitsy-search-btn"
        class="bitsy-ymm-btn"
        style="background: {{ block.settings.button_color }}; color: white;"
        disabled
      >
        Find Parts
      </button>
    </div>
  </div>
</div>

<style>
  .bitsy-ymm-search {
    padding: 1rem;
    background: #f9f9f9;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }
  .bitsy-ymm-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .bitsy-ymm-heading {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .bitsy-ymm-dropdowns {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    flex: 1;
  }
  .bitsy-ymm-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
    background: white;
    cursor: pointer;
    flex: 1;
    min-width: 120px;
  }
  .bitsy-ymm-select:disabled {
    background: #f5f5f5;
    cursor: not-allowed;
  }
  .bitsy-ymm-btn {
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .bitsy-ymm-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  @media (max-width: 768px) {
    .bitsy-ymm-inner { flex-direction: column; align-items: flex-start; }
    .bitsy-ymm-select { min-width: 100px; }
  }
</style>

<script src="{{ 'ymm.js' | asset_url }}" defer></script>