{% schema %}
{
  "name": "YMM Collection Filter",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Filter by your vehicle"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e63e2f"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Width %",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}

<div class="ymm-cf-wrap" id="ymm-cf-wrap">
  <div class="ymm-cf-inner">
    <span class="ymm-cf-heading">{{ block.settings.heading }}</span>
    <div class="ymm-cf-dropdowns">
      <select id="ymm-cf-make" class="ymm-cf-select">
        <option value="">Select Make</option>
      </select>
      <select id="ymm-cf-model" class="ymm-cf-select" disabled>
        <option value="">Select Model</option>
      </select>
      <select id="ymm-cf-year" class="ymm-cf-select" disabled>
        <option value="">Select Year</option>
      </select>
      <button id="ymm-cf-filter" class="ymm-cf-btn" disabled
        style="background: {{ block.settings.button_color }}; color: white;">
        Filter
      </button>
      <button id="ymm-cf-reset" class="ymm-cf-reset-btn" style="display:none;">
        Clear filter
      </button>
    </div>
  </div>
  <div id="ymm-cf-status" class="ymm-cf-status" style="display:none;"></div>
</div>

<style>
  .ymm-cf-wrap {
    padding: 1rem;
    background: #f9f9f9;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    margin-bottom: 1.5rem;
    max-width: {{ block.settings.max_width }}%;
    {% if block.settings.alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% else %}
      margin-left: 0;
      margin-right: auto;
    {% endif %}
  }
  .ymm-cf-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .ymm-cf-heading {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .ymm-cf-dropdowns {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    flex: 1;
  }
  .ymm-cf-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
    background: white;
    cursor: pointer;
    flex: 1;
    min-width: 120px;
  }
  .ymm-cf-select:disabled {
    background: #f5f5f5;
    cursor: not-allowed;
  }
  .ymm-cf-btn {
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .ymm-cf-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ymm-cf-reset-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.85rem;
    background: white;
    cursor: pointer;
    color: {{ block.settings.accent_color }};
    text-decoration: underline;
    white-space: nowrap;
  }
  .ymm-cf-status {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: #666;
    padding: 0.5rem 0.75rem;
    background: #fff;
    border-radius: 4px;
    border: 1px solid #e5e5e5;
  }
  .ymm-cf-hidden {
    display: none !important;
  }
  .ymm-cf-loading-bar {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: #999;
    padding: 0.5rem 0.75rem;
    background: #fff;
    border-radius: 4px;
    border: 1px solid #e5e5e5;
    display: none;
  }
  @media (max-width: 768px) {
    .ymm-cf-wrap {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
    .ymm-cf-inner {
      flex-direction: column;
      align-items: stretch;
    }
    .ymm-cf-heading {
      text-align: center;
    }
    .ymm-cf-dropdowns {
      flex-direction: column;
    }
    .ymm-cf-select {
      width: 100%;
      min-width: unset;
    }
    .ymm-cf-btn {
      width: 100%;
      padding: 0.75rem;
    }
    .ymm-cf-reset-btn {
      width: 100%;
      text-align: center;
      padding: 0.75rem;
    }
  }
</style>

<script>
  var YMM_CF_SUPABASE_URL = 'https://mpvhnycxwntslepogfuc.supabase.co';
  var YMM_CF_ANON_KEY = 'sb_publishable_shCSxRk-MJJDWblwk9IJwQ_iCwrl3CT';

  var YMM_CF_HEADERS = {
    apikey: YMM_CF_ANON_KEY,
    Authorization: 'Bearer ' + YMM_CF_ANON_KEY,
    'Content-Type': 'application/json'
  };

  var cfMake   = document.getElementById('ymm-cf-make');
  var cfModel  = document.getElementById('ymm-cf-model');
  var cfYear   = document.getElementById('ymm-cf-year');
  var cfBtn    = document.getElementById('ymm-cf-filter');
  var cfReset  = document.getElementById('ymm-cf-reset');
  var cfStatus = document.getElementById('ymm-cf-status');

  // Get collection handle from URL
  var collectionHandle = window.location.pathname.split('/collections/')[1];
  if (collectionHandle) collectionHandle = collectionHandle.split('/')[0].split('?')[0];

  // Store all loaded products
  var allCollectionHandles = null;

  // Load all collection products via AJAX across all pages
  async function loadAllCollectionProducts() {
    if (allCollectionHandles) return allCollectionHandles;
    if (!collectionHandle) return new Set();

    var handles = new Set();
    var page = 1;
    var hasMore = true;

    cfStatus.style.display = 'block';
    cfStatus.textContent = 'Loading all products...';

    while (hasMore) {
      try {
        var res = await fetch(
          '/collections/' + collectionHandle + '/products.json?limit=250&page=' + page
        );
        var data = await res.json();
        var products = data.products || [];

        products.forEach(function(p) {
          handles.add(p.handle);
        });

        cfStatus.textContent = 'Loading products... ' + handles.size + ' found';

        if (products.length < 250) {
          hasMore = false;
        } else {
          page++;
        }
      } catch (err) {
        console.error('Error loading collection page', page, err);
        hasMore = false;
      }
    }

    allCollectionHandles = handles;
    cfStatus.style.display = 'none';
    return handles;
  }

  // Load makes
  fetch(YMM_CF_SUPABASE_URL + '/rest/v1/distinct_makes?select=make', { headers: YMM_CF_HEADERS })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      data.forEach(function(row) {
        var opt = document.createElement('option');
        opt.value = row.make;
        opt.textContent = row.make;
        cfMake.appendChild(opt);
      });
    });

  cfMake.addEventListener('change', function() {
    var make = cfMake.value;
    cfModel.innerHTML = '<option value="">Select Model</option>';
    cfYear.innerHTML = '<option value="">Select Year</option>';
    cfModel.disabled = true;
    cfYear.disabled = true;
    cfBtn.disabled = true;
    if (!make) return;
    fetch(YMM_CF_SUPABASE_URL + '/rest/v1/distinct_models?select=model&make=eq.' + encodeURIComponent(make), { headers: YMM_CF_HEADERS })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(row) {
          var opt = document.createElement('option');
          opt.value = row.model;
          opt.textContent = row.model;
          cfModel.appendChild(opt);
        });
        cfModel.disabled = false;
      });
  });

  cfModel.addEventListener('change', function() {
    var make = cfMake.value;
    var model = cfModel.value;
    cfYear.innerHTML = '<option value="">Select Year</option>';
    cfYear.disabled = true;
    cfBtn.disabled = true;
    if (!model) return;
    fetch(YMM_CF_SUPABASE_URL + '/rest/v1/distinct_years?select=year&make=eq.' + encodeURIComponent(make) + '&model=eq.' + encodeURIComponent(model), { headers: YMM_CF_HEADERS })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        data.forEach(function(row) {
          var opt = document.createElement('option');
          opt.value = row.year;
          opt.textContent = row.year;
          cfYear.appendChild(opt);
        });
        cfYear.disabled = false;
      });
  });

  cfYear.addEventListener('change', function() {
    cfBtn.disabled = !cfYear.value;
  });

  cfBtn.addEventListener('click', async function() {
    var make  = cfMake.value;
    var model = cfModel.value;
    var year  = cfYear.value;

    cfBtn.textContent = 'Filtering...';
    cfBtn.disabled = true;

    // Load all collection products if not already loaded
    var collectionHandles = await loadAllCollectionProducts();

    // Get fitment products from Supabase
    var body = '{"p_make":"' + make + '","p_model":"' + model + '","p_year":"' + year + '"}';
    var res = await fetch(
      YMM_CF_SUPABASE_URL + '/rest/v1/rpc/get_fitment_products',
      { method: 'POST', headers: YMM_CF_HEADERS, body: body }
    );
    var fitmentProducts = await res.json();

    // Build set of handles that fit AND are in this collection
    var fitHandles = new Set((fitmentProducts || []).map(function(p) {
      return p.product_handle;
    }));

    // Intersection — only show products that are in collection AND fit the vehicle
    var validHandles = new Set();
    fitHandles.forEach(function(h) {
      if (collectionHandles.has(h)) validHandles.add(h);
    });

    // Now rebuild the product grid with only fitting products
    var grid = document.querySelector('.product-grid');
    var cards = document.querySelectorAll('.product-card');
    var shown = 0;
    var hidden = 0;

    cards.forEach(function(card) {
      var link = card.querySelector('a[href*="/products/"]');
      var handle = null;
      if (link) {
        var href = link.getAttribute('href');
        var match = href.match(/\/products\/([^?#\/]+)/);
        if (match) handle = match[1];
      }

      var wrapper = card.parentElement || card;

      if (handle && validHandles.has(handle)) {
        wrapper.classList.remove('ymm-cf-hidden');
        shown++;
      } else if (handle) {
        wrapper.classList.add('ymm-cf-hidden');
        hidden++;
      }
    });

    // If there are products not in DOM (other pages) inject them
    var missingHandles = [];
    validHandles.forEach(function(h) {
      var found = false;
      cards.forEach(function(card) {
        var link = card.querySelector('a[href*="/products/' + h + '"]');
        if (link) found = true;
      });
      if (!found) missingHandles.push(h);
    });

    // Fetch and inject missing products
    if (missingHandles.length > 0 && grid) {
      var fetchPromises = missingHandles.map(function(handle) {
        return fetch('/products/' + handle + '.js')
          .then(function(r) { return r.json(); })
          .then(function(p) {
            var img = p.featured_image || '';
            var price = p.price ? 'R ' + (p.price / 100).toFixed(2) : '';
            var li = document.createElement('div');
            li.className = 'grid__item js-col col-12 col-sm-6 col-6 col-lg-3 ymm-cf-injected';
            li.innerHTML = '<div class="product-card">' +
              '<div class="product-card__image-wr">' +
                '<a href="/products/' + p.handle + '" class="product-card__image">' +
                  (img ? '<img src="' + img + '" alt="' + p.title + '" loading="lazy">' : '') +
                '</a>' +
              '</div>' +
              '<div class="product-card__info">' +
                '<div class="product-card__price">' + price + '</div>' +
                '<a href="/products/' + p.handle + '" class="product-card__name">' + p.title + '</a>' +
              '</div>' +
            '</div>';
            return li;
          })
          .catch(function() { return null; });
      });

      var injected = (await Promise.all(fetchPromises)).filter(function(el) { return el !== null; });
      injected.forEach(function(el) {
        grid.appendChild(el);
        shown++;
      });
    }

    cfStatus.style.display = 'block';
    cfStatus.textContent = 'Showing ' + shown + ' parts for ' + year + ' ' + make + ' ' + model + ' (' + hidden + ' hidden on this page)';
    cfReset.style.display = 'inline-block';
    cfBtn.textContent = 'Filter';
    cfBtn.disabled = false;
  });

  cfReset.addEventListener('click', function() {
    // Remove injected products
    document.querySelectorAll('.ymm-cf-injected').forEach(function(el) { el.remove(); });

    // Show all original cards
    var cards = document.querySelectorAll('.product-card');
    cards.forEach(function(card) {
      var wrapper = card.parentElement || card;
      wrapper.classList.remove('ymm-cf-hidden');
    });

    cfStatus.style.display = 'none';
    cfReset.style.display = 'none';
    cfMake.value = '';
    cfModel.innerHTML = '<option value="">Select Model</option>';
    cfYear.innerHTML = '<option value="">Select Year</option>';
    cfModel.disabled = true;
    cfYear.disabled = true;
    cfBtn.disabled = true;

    // Reset cached collection handles so it reloads next time
    allCollectionHandles = null;
  });
</script>