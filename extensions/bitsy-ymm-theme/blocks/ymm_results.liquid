{% schema %}
{
  "name": "YMM Results",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e63e2f"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#111111"
    }
  ]
}
{% endschema %}

<div class="bymm-wrap">

  <div class="bymm-header">
    <div class="bymm-header-left">
      <span class="bymm-label">Results for</span>
      <h1 class="bymm-title" id="bymm-title">Loading...</h1>
    </div>
    <a href="/" class="bymm-change">Change vehicle</a>
  </div>

  <div id="bymm-loading" class="bymm-loading">
    <div class="bymm-spinner"></div>
    <p>Finding parts for your vehicle...</p>
  </div>

  <div class="bymm-layout" id="bymm-layout" style="display:none;">

    <aside class="bymm-filters">
      <div class="bymm-filter-header">
        <span>Filters</span>
        <button class="bymm-clear-btn" id="bymm-clear">Clear all</button>
      </div>

      <div class="bymm-filter-group">
        <button class="bymm-filter-title open" data-target="filter-vendor">
          Vendor <span class="bymm-chevron">&#9660;</span>
        </button>
        <div class="bymm-filter-body open" id="filter-vendor"></div>
      </div>

      <div class="bymm-filter-group">
        <button class="bymm-filter-title open" data-target="filter-type">
          Product Type <span class="bymm-chevron">&#9660;</span>
        </button>
        <div class="bymm-filter-body open" id="filter-type"></div>
      </div>

      <div class="bymm-filter-group">
        <button class="bymm-filter-title open" data-target="filter-price">
          Price <span class="bymm-chevron">&#9660;</span>
        </button>
        <div class="bymm-filter-body open" id="filter-price">
          <div class="bymm-price-inputs">
            <input type="number" id="price-min" placeholder="Min" class="bymm-price-input">
            <span>—</span>
            <input type="number" id="price-max" placeholder="Max" class="bymm-price-input">
          </div>
          <button class="bymm-apply-price" id="bymm-apply-price">Apply</button>
        </div>
      </div>

      <div class="bymm-filter-group">
        <label class="bymm-toggle-label">
          <input type="checkbox" id="filter-instock" class="bymm-toggle-input">
          <span class="bymm-toggle-track">
            <span class="bymm-toggle-thumb"></span>
          </span>
          In stock only
        </label>
      </div>

      <div class="bymm-filter-group">
        <button class="bymm-filter-title open" data-target="filter-tags">
          Tags <span class="bymm-chevron">&#9660;</span>
        </button>
        <div class="bymm-filter-body open" id="filter-tags"></div>
      </div>
    </aside>

    <div class="bymm-product-area">
      <div class="bymm-sort-bar">
        <span class="bymm-count" id="bymm-count"></span>
        <select class="bymm-sort-select" id="bymm-sort">
          <option value="default">Sort: Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="title-asc">Name: A-Z</option>
          <option value="title-desc">Name: Z-A</option>
        </select>
      </div>

      <div id="bymm-grid" class="bymm-grid"></div>

      <div id="bymm-empty" class="bymm-empty" style="display:none;">
        <p>No parts found with the current filters.</p>
        <button class="bymm-back-btn" id="bymm-clear-2">Clear filters</button>
      </div>

      <div id="bymm-show-more-wrap" style="display:none; text-align:center; margin-top:1.5rem;">
        <button id="bymm-show-more" class="bymm-show-more-btn">
          Show More <span id="bymm-remaining"></span>
        </button>
      </div>
    </div>
  </div>

  <div id="bymm-no-results" class="bymm-empty" style="display:none;">
    <p>No parts found for your vehicle.</p>
    <a href="/" class="bymm-back-btn">Search Again</a>
  </div>

  <div class="bymm-universal" id="bymm-universal" style="display:none;">
    <div class="bymm-universal-header">
      <h2 class="bymm-universal-title">Universal Fit Parts</h2>
      <p class="bymm-universal-sub">These parts are compatible with all vehicles</p>
    </div>
    <div id="bymm-universal-grid" class="bymm-grid"></div>
  </div>

</div>

<style>
  .bymm-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    font-family: inherit;
  }
  .bymm-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 1rem;
    border-bottom: 2px solid #111;
    margin-bottom: 1.5rem;
  }
  .bymm-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 0.2rem;
  }
  .bymm-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
  }
  .bymm-change {
    font-size: 0.85rem;
    color: {{ block.settings.accent_color }};
    text-decoration: underline;
    white-space: nowrap;
    margin-left: 1rem;
  }
  .bymm-loading {
    text-align: center;
    padding: 4rem 2rem;
    color: #999;
  }
  .bymm-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #eee;
    border-top-color: #111;
    border-radius: 50%;
    animation: bymm-spin 0.7s linear infinite;
    margin: 0 auto 1rem;
  }
  @keyframes bymm-spin { to { transform: rotate(360deg); } }
  .bymm-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    align-items: start;
  }
  .bymm-filters {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 1rem;
    position: sticky;
    top: 1rem;
  }
  .bymm-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .bymm-clear-btn {
    font-size: 0.78rem;
    color: {{ block.settings.accent_color }};
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }
  .bymm-filter-group {
    border-top: 1px solid #f0f0f0;
    padding: 0.65rem 0;
  }
  .bymm-filter-title {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-align: left;
  }
  .bymm-chevron {
    font-size: 0.65rem;
    transition: transform 0.2s;
  }
  .bymm-filter-title.open .bymm-chevron {
    transform: rotate(180deg);
  }
  .bymm-filter-body {
    margin-top: 0.6rem;
    display: none;
    flex-direction: column;
    gap: 0.4rem;
    max-height: 180px;
    overflow-y: auto;
  }
  .bymm-filter-body.open {
    display: flex;
  }
  .bymm-filter-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .bymm-filter-check input {
    width: 14px;
    height: 14px;
    cursor: pointer;
    accent-color: #111;
  }
  .bymm-price-inputs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .bymm-price-input {
    width: 70px;
    padding: 0.35rem 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.82rem;
  }
  .bymm-apply-price {
    width: 100%;
    padding: 0.4rem;
    background: #111;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .bymm-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }
  .bymm-toggle-input { display: none; }
  .bymm-toggle-track {
    width: 36px;
    height: 20px;
    background: #ddd;
    border-radius: 10px;
    position: relative;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .bymm-toggle-input:checked + .bymm-toggle-track { background: #111; }
  .bymm-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s;
  }
  .bymm-toggle-input:checked + .bymm-toggle-track .bymm-toggle-thumb {
    transform: translateX(16px);
  }
  .bymm-sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .bymm-count { font-size: 0.85rem; color: #666; }
  .bymm-sort-select {
    padding: 0.4rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.85rem;
    background: white;
    cursor: pointer;
  }
  .bymm-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .bymm-card {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
    background: white;
  }
  .bymm-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }
  .bymm-card-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f7f7f7;
    display: block;
  }
  .bymm-card-no-img {
    width: 100%;
    aspect-ratio: 1;
    background: #f7f7f7;
  }
  .bymm-card-body { padding: 0.75rem; }
  .bymm-card-vendor {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 0.2rem;
  }
  .bymm-card-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  .bymm-card-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 0.65rem;
  }
  .bymm-card-btn {
    display: block;
    width: 100%;
    padding: 0.55rem;
    text-align: center;
    color: white;
    background: {{ block.settings.button_color }};
    border: none;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .bymm-card-btn:hover { opacity: 0.85; }
  .bymm-card-oos {
    display: block;
    width: 100%;
    padding: 0.55rem;
    text-align: center;
    color: #999;
    background: #f5f5f5;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    font-size: 0.82rem;
  }
  .bymm-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: #999;
  }
  .bymm-back-btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.65rem 1.5rem;
    background: #111;
    color: white;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
  }
  .bymm-show-more-btn {
    padding: 0.75rem 2.5rem;
    background: white;
    color: #111;
    border: 2px solid #111;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .bymm-show-more-btn:hover {
    background: #111;
    color: white;
  }
  .bymm-universal {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #f0f0f0;
  }
  .bymm-universal-header { margin-bottom: 1.5rem; }
  .bymm-universal-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.3rem;
  }
  .bymm-universal-sub {
    font-size: 0.85rem;
    color: #999;
    margin: 0;
  }
  @media (max-width: 768px) {
    .bymm-layout { grid-template-columns: 1fr; }
    .bymm-filters { position: static; }
    .bymm-grid { grid-template-columns: repeat(2, 1fr); }
    .bymm-title { font-size: 1.2rem; }
  }
</style>

<script>
  var SUPABASE_URL = 'https://urffwytspjtqnpeubmjz.supabase.co';
  var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVyZmZ3eXRzcGp0cW5wZXVibWp6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjAxMDMsImV4cCI6MjEwMzM5NjEwM30.8fKCpIxBV3jd3osCQcJSk1MQD6R4jLnHBMNGTtsxGHc';

  var urlParams = new URLSearchParams(window.location.search);
  var SELECTED_MAKE  = urlParams.get('make') || '';
  var SELECTED_MODEL = urlParams.get('model') || '';
  var SELECTED_YEAR  = urlParams.get('year') || '';

  var HEADERS = {
    apikey: SUPABASE_ANON_KEY,
    Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
    'Content-Type': 'application/json'
  };

  var allProducts = [];
  var filteredProducts = [];
  var activeVendors = new Set();
  var activeTypes = new Set();
  var activeTags = new Set();
  var minPrice = null;
  var maxPrice = null;
  var inStockOnly = false;
  var sortOrder = 'default';
  var currentPage = 1;
  var PAGE_SIZE = 20;

  var titleEl      = document.getElementById('bymm-title');
  var loadingEl    = document.getElementById('bymm-loading');
  var layoutEl     = document.getElementById('bymm-layout');
  var gridEl       = document.getElementById('bymm-grid');
  var emptyEl      = document.getElementById('bymm-empty');
  var noResultsEl  = document.getElementById('bymm-no-results');
  var countEl      = document.getElementById('bymm-count');
  var universalEl  = document.getElementById('bymm-universal');
  var uniGridEl    = document.getElementById('bymm-universal-grid');
  var showMoreWrap = document.getElementById('bymm-show-more-wrap');
  var remainingEl  = document.getElementById('bymm-remaining');

  function buildCard(p) {
    var img    = p.image_url || '';
    var title  = p.product_title || 'Product';
    var price  = p.price ? 'R ' + parseFloat(p.price).toFixed(2) : '';
    var handle = p.product_handle || '';
    var vendor = p.vendor || '';
    var inStock = p.inventory_quantity === null || p.inventory_quantity === undefined || p.inventory_quantity > 0;

    return '<div class="bymm-card">' +
      (img
        ? '<img class="bymm-card-img" src="' + img + '" alt="' + title + '" loading="lazy">'
        : '<div class="bymm-card-no-img"></div>') +
      '<div class="bymm-card-body">' +
        (vendor ? '<p class="bymm-card-vendor">' + vendor + '</p>' : '') +
        '<p class="bymm-card-title">' + title + '</p>' +
        (price ? '<p class="bymm-card-price">' + price + '</p>' : '') +
        (handle
          ? (inStock
              ? '<a href="/products/' + handle + '" class="bymm-card-btn">View Product</a>'
              : '<span class="bymm-card-oos">Out of stock</span>')
          : '') +
      '</div></div>';
  }

  function buildFilters(products) {
    var vendors = [];
    var types = [];
    var tags = [];
    var vendorSet = {};
    var typeSet = {};
    var tagSet = {};

    products.forEach(function(p) {
      if (p.vendor && !vendorSet[p.vendor]) { vendorSet[p.vendor] = true; vendors.push(p.vendor); }
      if (p.product_type && !typeSet[p.product_type]) { typeSet[p.product_type] = true; types.push(p.product_type); }
      if (p.tags) {
        p.tags.split(',').forEach(function(t) {
          t = t.trim();
          if (t && !tagSet[t]) { tagSet[t] = true; tags.push(t); }
        });
      }
    });

    vendors.sort();
    types.sort();
    tags.sort();

    renderCheckboxes('filter-vendor', vendors, activeVendors, function(v) {
      if (activeVendors.has(v)) { activeVendors.delete(v); } else { activeVendors.add(v); }
      currentPage = 1;
      applyFilters();
    });
    renderCheckboxes('filter-type', types, activeTypes, function(v) {
      if (activeTypes.has(v)) { activeTypes.delete(v); } else { activeTypes.add(v); }
      currentPage = 1;
      applyFilters();
    });
    renderCheckboxes('filter-tags', tags.slice(0, 30), activeTags, function(v) {
      if (activeTags.has(v)) { activeTags.delete(v); } else { activeTags.add(v); }
      currentPage = 1;
      applyFilters();
    });
  }

  function renderCheckboxes(containerId, values, activeSet, onChange) {
    var container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';
    if (values.length === 0) {
      container.innerHTML = '<span style="font-size:0.78rem;color:#bbb">None available</span>';
      return;
    }
    values.forEach(function(val) {
      var label = document.createElement('label');
      label.className = 'bymm-filter-check';
      var cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = activeSet.has(val);
      cb.addEventListener('change', function() { onChange(val); });
      label.appendChild(cb);
      label.appendChild(document.createTextNode(val));
      container.appendChild(label);
    });
  }

  function applyFilters() {
    var result = allProducts.slice();

    if (activeVendors.size > 0) {
      result = result.filter(function(p) { return activeVendors.has(p.vendor); });
    }
    if (activeTypes.size > 0) {
      result = result.filter(function(p) { return activeTypes.has(p.product_type); });
    }
    if (activeTags.size > 0) {
      result = result.filter(function(p) {
        var ptags = p.tags ? p.tags.split(',').map(function(t) { return t.trim(); }) : [];
        return ptags.some(function(t) { return activeTags.has(t); });
      });
    }
    if (minPrice !== null) {
      result = result.filter(function(p) { return parseFloat(p.price || 0) >= minPrice; });
    }
    if (maxPrice !== null) {
      result = result.filter(function(p) { return parseFloat(p.price || 0) <= maxPrice; });
    }
    if (inStockOnly) {
      result = result.filter(function(p) {
        return p.inventory_quantity === null || p.inventory_quantity === undefined || p.inventory_quantity > 0;
      });
    }
    if (sortOrder === 'price-asc') {
      result.sort(function(a, b) { return parseFloat(a.price || 0) - parseFloat(b.price || 0); });
    } else if (sortOrder === 'price-desc') {
      result.sort(function(a, b) { return parseFloat(b.price || 0) - parseFloat(a.price || 0); });
    } else if (sortOrder === 'title-asc') {
      result.sort(function(a, b) { return (a.product_title || '').localeCompare(b.product_title || ''); });
    } else if (sortOrder === 'title-desc') {
      result.sort(function(a, b) { return (b.product_title || '').localeCompare(a.product_title || ''); });
    }

    filteredProducts = result;
    renderGrid();
  }

  function renderGrid() {
    var total   = filteredProducts.length;
    var showing = Math.min(currentPage * PAGE_SIZE, total);
    var visible = filteredProducts.slice(0, showing);

    countEl.textContent = total + ' part(s) found';

    if (total === 0) {
      gridEl.innerHTML = '';
      emptyEl.style.display = 'block';
      showMoreWrap.style.display = 'none';
    } else {
      emptyEl.style.display = 'none';
      gridEl.innerHTML = visible.map(buildCard).join('');
      if (showing < total) {
        showMoreWrap.style.display = 'block';
        remainingEl.textContent = '(' + (total - showing) + ' more)';
      } else {
        showMoreWrap.style.display = 'none';
      }
    }
  }

  function clearFilters() {
    activeVendors.clear();
    activeTypes.clear();
    activeTags.clear();
    minPrice = null;
    maxPrice = null;
    inStockOnly = false;
    currentPage = 1;
    document.getElementById('price-min').value = '';
    document.getElementById('price-max').value = '';
    document.getElementById('filter-instock').checked = false;
    document.querySelectorAll('.bymm-filter-check input').forEach(function(cb) { cb.checked = false; });
    applyFilters();
  }

  document.querySelectorAll('.bymm-filter-title').forEach(function(btn) {
    var body = document.getElementById(btn.dataset.target);
    if (body) { body.classList.add('open'); btn.classList.add('open'); }
    btn.addEventListener('click', function() {
      if (!body) return;
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open', !isOpen);
      btn.classList.toggle('open', !isOpen);
    });
  });

  document.getElementById('bymm-clear').addEventListener('click', clearFilters);
  document.getElementById('bymm-clear-2').addEventListener('click', clearFilters);
  document.getElementById('filter-instock').addEventListener('change', function(e) {
    inStockOnly = e.target.checked;
    currentPage = 1;
    applyFilters();
  });
  document.getElementById('bymm-sort').addEventListener('change', function(e) {
    sortOrder = e.target.value;
    currentPage = 1;
    applyFilters();
  });
  document.getElementById('bymm-apply-price').addEventListener('click', function() {
    minPrice = document.getElementById('price-min').value ? parseFloat(document.getElementById('price-min').value) : null;
    maxPrice = document.getElementById('price-max').value ? parseFloat(document.getElementById('price-max').value) : null;
    currentPage = 1;
    applyFilters();
  });
  document.getElementById('bymm-show-more').addEventListener('click', function() {
    currentPage++;
    renderGrid();
    var cards = gridEl.querySelectorAll('.bymm-card');
    var firstNew = cards[(currentPage - 1) * PAGE_SIZE];
    if (firstNew) firstNew.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

async function loadFittedProducts() {
  var body = '{"p_make":"' + SELECTED_MAKE + '","p_model":"' + SELECTED_MODEL + '","p_year":"' + SELECTED_YEAR + '"}';
console.log('Calling RPC with body:', body);
console.log('SELECTED_MAKE:', SELECTED_MAKE);
console.log('SELECTED_MODEL:', SELECTED_MODEL);
console.log('SELECTED_YEAR:', SELECTED_YEAR);
  var res = await fetch(
    SUPABASE_URL + '/rest/v1/rpc/get_fitment_products',
    {
      method: 'POST',
      headers: HEADERS,
      body: body
    }
  );
  var data = await res.json();
  console.log('Products from RPC:', data ? data.length : 0);
  return data || [];
}

  async function loadUniversalProducts() {
    var res = await fetch(
      SUPABASE_URL + '/rest/v1/rpc/get_universal_products',
      {
        method: 'POST',
        headers: HEADERS,
        body: '{}'
      }
    );
var data = await res.json();
console.log('Full RPC response:', JSON.stringify(data));
return data || [];
  }

  async function init() {
    if (!SELECTED_MAKE || !SELECTED_MODEL || !SELECTED_YEAR) {
      loadingEl.style.display = 'none';
      noResultsEl.style.display = 'block';
      return;
    }

    titleEl.textContent = SELECTED_YEAR + ' ' + SELECTED_MAKE + ' ' + SELECTED_MODEL;

    try {
      var fittedData = await loadFittedProducts();
      var universalData = await loadUniversalProducts();

      loadingEl.style.display = 'none';

      if (!fittedData || fittedData.length === 0) {
        noResultsEl.style.display = 'block';
      } else {
        layoutEl.style.display = 'grid';
        allProducts = fittedData;
        buildFilters(allProducts);
        applyFilters();
      }

      if (universalData && universalData.length > 0) {
        universalEl.style.display = 'block';
        uniGridEl.innerHTML = universalData.map(buildCard).join('');
      }

    } catch (err) {
      loadingEl.textContent = 'Failed to load results. Please try again.';
      console.error(err);
    }
  }

  init();
</script>
