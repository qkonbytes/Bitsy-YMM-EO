{% schema %}
{
  "name": "YMM Results V2",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e63e2f"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#111111"
    }
  ]
}
{% endschema %}

<div class="bymm-wrap">

  <div class="bymm-header">
    <div class="bymm-header-left">
      <span class="bymm-label">Results for</span>
      <h1 class="bymm-title" id="bymm-title">Loading...</h1>
    </div>
    <a href="/" class="bymm-change">Change vehicle</a>
  </div>

  <div id="bymm-loading" class="bymm-loading">
    <div class="bymm-spinner"></div>
    <p>Finding parts for your vehicle...</p>
  </div>

  <div class="bymm-product-area" id="bymm-layout" style="display:none;">
    <div class="bymm-sort-bar">
      <span class="bymm-count" id="bymm-count"></span>
      <select class="bymm-sort-select" id="bymm-sort">
        <option value="default">Sort: Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="title-asc">Name: A-Z</option>
        <option value="title-desc">Name: Z-A</option>
      </select>
    </div>

    <div id="bymm-grid" class="bymm-grid"></div>

    <div id="bymm-empty" class="bymm-empty" style="display:none;">
      <p>No parts found for your vehicle.</p>
    </div>

    <div id="bymm-show-more-wrap" style="display:none; text-align:center; margin-top:1.5rem;">
      <button id="bymm-show-more" class="bymm-show-more-btn">
        Show More <span id="bymm-remaining"></span>
      </button>
    </div>
  </div>

  <div id="bymm-no-results" class="bymm-empty" style="display:none;">
    <p>No parts found for your vehicle.</p>
    <a href="/" class="bymm-back-btn">Search Again</a>
  </div>

</div>

<style>
  .bymm-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    font-family: inherit;
  }
  .bymm-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 1rem;
    border-bottom: 2px solid #111;
    margin-bottom: 1.5rem;
  }
  .bymm-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 0.2rem;
  }
  .bymm-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
  }
  .bymm-change {
    font-size: 0.85rem;
    color: {{ block.settings.accent_color }};
    text-decoration: underline;
    white-space: nowrap;
    margin-left: 1rem;
  }
  .bymm-loading {
    text-align: center;
    padding: 4rem 2rem;
    color: #999;
  }
  .bymm-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #eee;
    border-top-color: #111;
    border-radius: 50%;
    animation: bymm-spin 0.7s linear infinite;
    margin: 0 auto 1rem;
  }
  @keyframes bymm-spin { to { transform: rotate(360deg); } }
  .bymm-sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .bymm-count { font-size: 0.85rem; color: #666; }
  .bymm-sort-select {
    padding: 0.4rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.85rem;
    background: white;
    cursor: pointer;
  }
  .bymm-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .bymm-card {
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
    background: white;
  }
  .bymm-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }
  .bymm-card-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f7f7f7;
    display: block;
  }
  .bymm-card-no-img {
    width: 100%;
    aspect-ratio: 1;
    background: #f7f7f7;
  }
  .bymm-card-body { padding: 0.75rem; }
  .bymm-card-vendor {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 0.2rem;
  }
  .bymm-card-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.3;
  }
  .bymm-card-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 0.65rem;
  }
  .bymm-card-btn {
    display: block;
    width: 100%;
    padding: 0.55rem;
    text-align: center;
    color: white;
    background: {{ block.settings.button_color }};
    border: none;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .bymm-card-btn:hover { opacity: 0.85; }
  .bymm-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: #999;
  }
  .bymm-back-btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.65rem 1.5rem;
    background: #111;
    color: white;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
  }
  .bymm-show-more-btn {
    padding: 0.75rem 2.5rem;
    background: white;
    color: #111;
    border: 2px solid #111;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .bymm-show-more-btn:hover { background: #111; color: white; }
  @media (max-width: 768px) {
    .bymm-grid { grid-template-columns: repeat(2, 1fr); }
    .bymm-title { font-size: 1.2rem; }
  }
</style>

<script>
  var SUPABASE_URL = 'https://mpvhnycxwntslepogfuc.supabase.co';
  var SUPABASE_ANON_KEY = 'sb_publishable_shCSxRk-MJJDWblwk9IJwQ_iCwrl3CT';

  var urlParams = new URLSearchParams(window.location.search);
  var SELECTED_MAKE  = urlParams.get('make') || '';
  var SELECTED_MODEL = urlParams.get('model') || '';
  var SELECTED_YEAR  = urlParams.get('year') || '';

  var HEADERS = {
    apikey: SUPABASE_ANON_KEY,
    Authorization: 'Bearer ' + SUPABASE_ANON_KEY,
    'Content-Type': 'application/json'
  };

  var allProducts = [];
  var filteredProducts = [];
  var sortOrder = 'default';
  var currentPage = 1;
  var PAGE_SIZE = 20;

  var titleEl     = document.getElementById('bymm-title');
  var loadingEl   = document.getElementById('bymm-loading');
  var layoutEl    = document.getElementById('bymm-layout');
  var gridEl      = document.getElementById('bymm-grid');
  var emptyEl     = document.getElementById('bymm-empty');
  var noResultsEl = document.getElementById('bymm-no-results');
  var countEl     = document.getElementById('bymm-count');
  var showMoreWrap = document.getElementById('bymm-show-more-wrap');
  var remainingEl = document.getElementById('bymm-remaining');

  function buildCard(p) {
    var img    = p.image_url || '';
    var title  = p.product_title || 'Product';
    var price  = p.price ? 'R ' + parseFloat(p.price).toFixed(2) : '';
    var handle = p.product_handle || '';
    var vendor = p.vendor || '';

    return '<div class="bymm-card">' +
      (img
        ? '<img class="bymm-card-img" src="' + img + '" alt="' + title + '" loading="lazy">'
        : '<div class="bymm-card-no-img"></div>') +
      '<div class="bymm-card-body">' +
        (vendor ? '<p class="bymm-card-vendor">' + vendor + '</p>' : '') +
        '<p class="bymm-card-title">' + title + '</p>' +
        (price ? '<p class="bymm-card-price">' + price + '</p>' : '') +
        (handle ? '<a href="/products/' + handle + '" class="bymm-card-btn">View Product</a>' : '') +
      '</div></div>';
  }

  function applySort() {
    var result = allProducts.slice();
    if (sortOrder === 'price-asc') {
      result.sort(function(a, b) { return parseFloat(a.price || 0) - parseFloat(b.price || 0); });
    } else if (sortOrder === 'price-desc') {
      result.sort(function(a, b) { return parseFloat(b.price || 0) - parseFloat(a.price || 0); });
    } else if (sortOrder === 'title-asc') {
      result.sort(function(a, b) { return (a.product_title || '').localeCompare(b.product_title || ''); });
    } else if (sortOrder === 'title-desc') {
      result.sort(function(a, b) { return (b.product_title || '').localeCompare(a.product_title || ''); });
    }
    filteredProducts = result;
    renderGrid();
  }

  function renderGrid() {
    var total   = filteredProducts.length;
    var showing = Math.min(currentPage * PAGE_SIZE, total);
    var visible = filteredProducts.slice(0, showing);

    countEl.textContent = total + ' part(s) found';

    if (total === 0) {
      gridEl.innerHTML = '';
      emptyEl.style.display = 'block';
      showMoreWrap.style.display = 'none';
    } else {
      emptyEl.style.display = 'none';
      gridEl.innerHTML = visible.map(buildCard).join('');
      if (showing < total) {
        showMoreWrap.style.display = 'block';
        remainingEl.textContent = '(' + (total - showing) + ' more)';
      } else {
        showMoreWrap.style.display = 'none';
      }
    }
  }

  document.getElementById('bymm-sort').addEventListener('change', function(e) {
    sortOrder = e.target.value;
    currentPage = 1;
    applySort();
  });

  document.getElementById('bymm-show-more').addEventListener('click', function() {
    currentPage++;
    renderGrid();
    var cards = gridEl.querySelectorAll('.bymm-card');
    var firstNew = cards[(currentPage - 1) * PAGE_SIZE];
    if (firstNew) firstNew.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  async function loadFittedProducts() {
    var body = '{"p_make":"' + SELECTED_MAKE + '","p_model":"' + SELECTED_MODEL + '","p_year":"' + SELECTED_YEAR + '"}';
    var res = await fetch(
      SUPABASE_URL + '/rest/v1/rpc/get_fitment_products',
      { method: 'POST', headers: HEADERS, body: body }
    );
    var supabaseProducts = await res.json();
    if (!supabaseProducts || supabaseProducts.length === 0) return [];

    var fetchPromises = supabaseProducts
      .filter(function(p) { return p.product_handle; })
      .map(function(sp) {
        return fetch('/products/' + sp.product_handle + '.js')
          .then(function(r) { return r.json(); })
          .then(function(d) {
            return {
              product_title: d.title,
              product_handle: d.handle,
              vendor: d.vendor,
              product_type: d.type,
              tags: d.tags || [],
              price: d.price ? (d.price / 100).toFixed(2) : null,
              image_url: d.featured_image,
              available: d.available,
              shopify_product_id: sp.shopify_product_id
            };
          })
          .catch(function() { return null; });
      });

    var products = (await Promise.all(fetchPromises)).filter(function(p) { return p !== null; });
    return products;
  }

  async function init() {
    if (!SELECTED_MAKE || !SELECTED_MODEL || !SELECTED_YEAR) {
      loadingEl.style.display = 'none';
      noResultsEl.style.display = 'block';
      return;
    }

    titleEl.textContent = SELECTED_YEAR + ' ' + SELECTED_MAKE + ' ' + SELECTED_MODEL;

    try {
      var fittedData = await loadFittedProducts();
      loadingEl.style.display = 'none';

      if (!fittedData || fittedData.length === 0) {
        noResultsEl.style.display = 'block';
      } else {
        layoutEl.style.display = 'block';
        allProducts = fittedData;
        filteredProducts = allProducts.slice();
        renderGrid();
      }

    } catch (err) {
      loadingEl.textContent = 'Failed to load results. Please try again.';
      console.error(err);
    }
  }

  init();
</script>